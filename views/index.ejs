<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Infix Converter</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">DSA Project</p>
          <h1>Infix to Postfix & Prefix Converter</h1>
        </div>
        <a href="/visualizer" class="secondary-btn">Open Visualizer</a>
      </header>

      <main class="container">
        <section class="home-hero" aria-labelledby="hero-heading">
          <div class="hero-copy">
            <p class="hero-kicker">A clearer way to understand expressions</p>
            <h2 id="hero-heading">Turn infix expressions into <span>prefix or postfix</span>.</h2>
            <p class="hero-description">
              Explore how stacks and operator precedence transform familiar expressions into forms computers can evaluate with ease.
            </p>
            <a href="#converter" class="hero-cta">Start converting <span aria-hidden="true">&#8595;</span></a>
          </div>
          <div class="hero-visual" aria-hidden="true">
            <div class="expression-card expression-input">
              <span>Infix</span>
              <strong>A + B * (C - D)</strong>
            </div>
            <div class="hero-arrow">&#8595;</div>
            <div class="expression-outputs">
              <div class="expression-card">
                <span>Postfix</span>
                <strong>A B C D - * +</strong>
              </div>
              <div class="expression-card">
                <span>Prefix</span>
                <strong>+ A * B - C D</strong>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" id="converter">
          <div class="hero-block">
            <p class="hero-title">Expression converter</p>
            <p class="hero-subtitle">Convert infix expressions to postfix or prefix using stack logic.</p>
          </div>

          <form action="/convert" method="POST" class="converter-form">
            <label for="expression">Enter an expression</label>
            <div class="input-row">
              <input
                id="expression"
                name="expression"
                type="text"
                value="<%= expression || '' %>"
                placeholder="Example: A+B*(C-D)"
                autocomplete="off"
              />
              <div class="toggle-group">
                <label class="mode-option">
                  <input type="radio" name="mode" value="postfix" <%= mode === 'postfix' || !mode ? 'checked' : '' %> />
                  <span>Postfix</span>
                </label>
                <label class="mode-option">
                  <input type="radio" name="mode" value="prefix" <%= mode === 'prefix' ? 'checked' : '' %> />
                  <span>Prefix</span>
                </label>
              </div>
              <button type="submit">Convert</button>
            </div>
          </form>

          <% if (error) { %>
            <div class="alert error">
              <strong>Invalid expression.</strong>
              <span><%= error.message %></span>
              <% if (typeof error.position === 'number') { %>
                <small>Position: <%= error.position %></small>
              <% } %>
            </div>
          <% } %>

          <% if (result && result.success) { %>
            <div class="result-grid">
              <div class="result-card fade-card">
                <span class="label"><%= mode === 'prefix' ? 'Prefix Output' : 'Postfix Output' %></span>
                <strong class="value"><%= mode === 'prefix' ? result.prefix : result.postfix %></strong>
              </div>
              <div class="result-card fade-card delay-1">
                <span class="label">Steps</span>
                <strong class="value"><%= result.steps.length %></strong>
              </div>
            </div>

            <div class="steps-panel">
              <h3>Algorithm Trace</h3>

              <% result.steps.forEach((step) => { %>
                <div class="step-item slide-up">
                  <div class="step-header">
                    <span class="step-index">#<%= step.index %></span>
                    <span class="badge"><%= step.action %></span>
                    <span class="token"><%= step.token %></span>
                  </div>
                  <p class="reason"><%= step.reason %></p>
                  <div class="state-grid">
                    <div>
                      <span>Stack</span>
                      <strong><%= step.stack.length ? step.stack.join(' ') : '[]' %></strong>
                    </div>
                    <div>
                      <span>Output</span>
                      <strong><%= step.output.length ? step.output.join(' ') : '[]' %></strong>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>
      </main>

      <footer class="site-footer">
        <span>Built with care by Mustafa Khan and Inshra Shaikh</span>
        <span>&copy; <%= new Date().getFullYear() %> All rights reserved.</span>
      </footer>
    </div>
  </body>
</html>
